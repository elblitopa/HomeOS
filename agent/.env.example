# HomeOS Windows Agent — copia este archivo a agent/.env y llénalo.
# El .env real NO se versiona, NO se imprime y NO viaja al cloud.

# URL de HomeOS Cloud (sin / al final). Ej: https://homeos.tudominio.com
HOMEOS_SERVER_URL=

# Token del agente. Se genera en HomeOS -> Ajustes -> PC Principal.
# Se muestra UNA sola vez; si se pierde, se regenera (el anterior muere).
HOMEOS_AGENT_TOKEN=

# Identidad de esta máquina (debe existir en el cloud).
HOMEOS_DEVICE_ID=pc-principal
HOMEOS_AGENT_NAME=PC Principal

# Carpetas donde el explorador remoto puede navegar, separadas por ;
# Vacío = browse deshabilitado. El agente jamás sale de estos roots.
# Ej: HOMEOS_ALLOWED_BROWSE_ROOTS=C:\Users\pablo\OneDrive\Documents\Proyectos
HOMEOS_ALLOWED_BROWSE_ROOTS=

# (Opcional) Ruta de homeos.db local para `python -m agent propose`.
# Default: ../data/homeos.db relativo a la carpeta agent/.
#HOMEOS_LOCAL_DB=
