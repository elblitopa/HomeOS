# ============================================================
# HomeOS — variables de entorno
#
# SIN este archivo (o sin ninguna variable definida) HomeOS corre
# en MODO LOCAL exactamente como siempre: sin autenticación, con
# SQLite en data/homeos.db y las apps lanzándose directo en Windows.
#
# Copia este archivo a .env y llena solo lo que necesites.
# NUNCA comitees el .env real.
# ============================================================

# ---------- selector de entorno (el ÚNICO flag de modo) ----------
# local  -> desarrollo / instalación en la PC (default)
# cloud  -> servidor 24/7: auth obligatoria, cookie Secure (HTTPS),
#           las apps van por el Windows Agent
HOMEOS_ENV=local

# ---------- servidor ----------
# Puerto de uvicorn (el arranque real lo pasa por CLI; esto alimenta defaults)
HOMEOS_PORT=8777

# URL pública con la que se llega a HomeOS. Arma el redirect de Google OAuth.
# En cloud con Tailscale Serve: https://homeos.<tu-tailnet>.ts.net
HOMEOS_PUBLIC_URL=http://localhost:8777

# Carpeta de datos (BD SQLite + uploads). Default: <repo>/data
# En la VM conviene sacarla del repo, p. ej. /srv/homeos/data
# HOMEOS_DATA_DIR=

# ---------- base de datos ----------
# Default: sqlite en HOMEOS_DATA_DIR/homeos.db
# Para Postgres (Supabase): postgresql+psycopg://usuario:password@host:5432/db
# (requiere instalar psycopg: pip install "psycopg[binary]")
# DATABASE_URL=

# ---------- secretos (OBLIGATORIOS en cloud; el arranque falla sin ellos) ----------
# La clave que tecleas en la pantalla de login.
# HOMEOS_ACCESS_KEY=

# Secreto que firma las cookies de sesión. Aleatorio, mínimo 32 caracteres.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotarlo cierra la sesión de todos los dispositivos sin cambiar la clave.
# HOMEOS_SESSION_SECRET=

# ============================================================
# El token del Windows Agent NO va aquí: se genera desde Ajustes
# (el servidor guarda solo su hash) y se pega en el .env del agente
# en la PC (carpeta /agent, fases 2-3).
# ============================================================
