# ============================================================
# HomeOS Cloud — .env de PRODUCCIÓN (la VM).
#
# Copia este archivo a /opt/homeos/.env en la VM y llena los
# valores. NUNCA lo comitees ni lo copies con valores reales
# a ningún lugar fuera de la VM.
# ============================================================

# Modo cloud: auth obligatoria, cookie Secure, apps por el Windows Agent.
# (docker-compose ya lo fija; se repite aquí por claridad y por si algún
# día se corre sin compose)
HOMEOS_ENV=cloud

# La URL HTTPS de Tailscale Serve con la que abres HomeOS.
# Ejemplo: https://homeos-cloud.tu-tailnet.ts.net
# (el nombre exacto lo da `tailscale status` / la consola de Tailscale)
HOMEOS_PUBLIC_URL=

# La clave que tecleas en la pantalla de login (elige una fuerte y larga).
HOMEOS_ACCESS_KEY=

# Secreto que firma las cookies de sesión. Mínimo 32 caracteres.
# Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# (o dentro del contenedor:
#   docker compose exec homeos python -c "import secrets; print(secrets.token_urlsafe(48))")
# Rotarlo desloguea todos los dispositivos sin cambiar la clave.
HOMEOS_SESSION_SECRET=

# Datos (SQLite + uploads). En el contenedor SIEMPRE es /app/data,
# que es el bind mount de /opt/homeos/data del host.
HOMEOS_DATA_DIR=/app/data

# SQLite por default (data/homeos.db). Para Postgres en el futuro:
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/homeos
# DATABASE_URL=

# ============================================================
# El token del Windows Agent NO va aquí: se genera en HomeOS ->
# Ajustes -> PC Principal y se pega en agent/.env de la PC.
# ============================================================
